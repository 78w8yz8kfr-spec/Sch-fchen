# Ausschließlich als Vorlage verwenden. Jede CHANGE_ME-Angabe kommt aus dem
# Secret-Store der geschützten Produktionsumgebung, niemals aus Git.
NODE_ENV=production
APP_ENVIRONMENT=production
API_ALLOWED_ORIGIN=https://app.example.invalid
API_COOKIE_SECURE=true
API_TRUSTED_PROXY_HOPS=1

DATABASE_URL=postgresql://database-host.example.invalid/schaefchen
API_DB_USER=schaefchen_api_login
API_DB_PASSWORD=CHANGE_ME_PRODUCTION_API_PASSWORD
API_DB_SSL_MODE=verify-full
# Bei einer privaten Zertifizierungsstelle als Secret mit echten Zeilen setzen.
API_DB_SSL_CA=
API_DB_POOL_SIZE=10

SECURITY_RATE_LIMIT_SECRET=CHANGE_ME_RANDOM_RATE_LIMIT_HMAC_SECRET_AT_LEAST_32_CHARS
SESSION_TTL_SECONDS=28800
APP_TIME_ZONE=Europe/Berlin

# Ohne konfigurierten Pflichtscanner startet Produktion nicht; ein nicht
# erreichbarer Scanner blockiert jeden Upload fail-closed.
UPLOAD_SCAN_REQUIRED=true
UPLOAD_SCAN_HOST=clamav.internal
UPLOAD_SCAN_PORT=3310
UPLOAD_SCAN_TIMEOUT_MS=15000

INITIAL_COMPANY_NUMBER=F-000001
INITIAL_SETUP_TOKEN=
PLATFORM_SETUP_TOKEN=
