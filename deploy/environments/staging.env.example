# Staging besitzt eigene Datenbank, Objektspeicher, Scanner und Geheimnisse.
# Es werden ausschließlich synthetische oder ausdrücklich freigegebene Daten genutzt.
NODE_ENV=production
APP_ENVIRONMENT=staging
API_ALLOWED_ORIGIN=https://staging.example.invalid
API_COOKIE_SECURE=true
API_TRUSTED_PROXY_HOPS=1

DATABASE_URL=postgresql://staging-database.example.invalid/schaefchen_staging
API_DB_USER=schaefchen_api_login
API_DB_PASSWORD=CHANGE_ME_STAGING_API_PASSWORD
API_DB_SSL_MODE=verify-full
API_DB_SSL_CA=
API_DB_POOL_SIZE=5

SECURITY_RATE_LIMIT_SECRET=CHANGE_ME_SEPARATE_STAGING_HMAC_SECRET_AT_LEAST_32_CHARS
SESSION_TTL_SECONDS=3600
APP_TIME_ZONE=Europe/Berlin
UPLOAD_SCAN_REQUIRED=true
UPLOAD_SCAN_HOST=clamav.staging.internal
UPLOAD_SCAN_PORT=3310
UPLOAD_SCAN_TIMEOUT_MS=15000

INITIAL_COMPANY_NUMBER=F-000001
INITIAL_SETUP_TOKEN=CHANGE_ME_STAGING_SETUP_TOKEN_AT_LEAST_24_CHARS
PLATFORM_SETUP_TOKEN=CHANGE_ME_STAGING_PLATFORM_TOKEN_AT_LEAST_24_CHARS
