FROM node:24-alpine

# Der PostgreSQL-Client fuehrt beim Start die Migrationen aus. Tesseract liest
# fotografierte Lieferscheine - im eigenen Haus und nicht bei einem Dienst im
# Netz, denn ein Lieferschein nennt Lieferant, Mengen und Preise. Das deutsche
# Sprachpaket ist Pflicht: ohne es liest die Erkennung "Lieferschein-Nr." als
# englisches Wortgebilde und findet die Beschriftung nicht.
#
# ImageMagick bringt das Foto vorher auf Arbeitsmass. Der Browser tut das
# schon, aber nicht verlaesslich: ein Telefon liefert HEIC, ein aelterer
# Browser kennt kein Canvas, und bei sehr grossen Bildern misslingt das
# Zeichnen still. Dann kam das Original an, und die Erkennung lief in die
# Zeitgrenze - im Betrieb zweimal beobachtet. Gemessen an 48 Megapixeln auf
# einem Kern: 6,5 s direkt, 1,6 s ueber den Umweg. Und HEIC, das Tesseract
# ueberhaupt nicht liest, kann ImageMagick oeffnen.
RUN apk add --no-cache postgresql-client tesseract-ocr tesseract-ocr-data-deu imagemagick

WORKDIR /app

COPY api/package*.json ./api/
RUN npm --prefix api ci --omit=dev --ignore-scripts \
    && npm cache clean --force

COPY api/src ./api/src
COPY frontend ./frontend
COPY database ./database
COPY deploy ./deploy

ENV NODE_ENV=production \
    API_PORT=10000 \
    STATIC_DIRECTORY=/app/frontend

USER node
EXPOSE 10000

CMD ["sh", "deploy/render-start.sh"]
